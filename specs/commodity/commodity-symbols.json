{
  "openapi": "3.1.1",
  "info": {
    "title": "Commodity Symbols API Reference",
    "version": "2.0.0",
    "description": "Full catalog of 520+ supported commodities across Metals, Energy, Agriculture, Industrial, Raw Materials, Oils and Meals, Textiles, Meats, Poultry, and Livestock, with pricing currency, unit, and update interval per symbol. Deprecated symbols stay listed with `status: \"inactive\"` and a `deprecationDate`.",
    "contact": {
      "name": "APIFreaks Support",
      "url": "https://apifreaks.com/contact",
      "email": "support@apifreaks.com"
    }
  },
  "servers": [
    {
      "url": "https://api.apifreaks.com/v2.0",
      "description": "Commodity Symbols API Server"
    }
  ],
  "paths": {
    "/commodity/symbols": {
      "get": {
        "tags": ["Commodity APIs"],
        "summary": "Get all supported commodity symbols",
        "description": "Returns the list of supported commodity symbols with metadata.",
        "operationId": "getCommoditySymbols",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Response format. Only `json` is supported; the default is `json`.",
            "schema": {
              "type": "string",
              "enum": ["json"],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommoditySymbolsResponse"
                },
                "examples": {
                  "success": {
                    "summary": "Successful response",
                    "value": {
                      "success": true,
                      "symbols": [
                        {
                          "symbol": "XAU",
                          "name": "Gold",
                          "category": "Metals",
                          "status": "active",
                          "updateInterval": "PER_SECOND",
                          "currency": {
                            "code": "USD",
                            "name": "US Dollar",
                            "symbol": "$"
                          },
                          "unit": {
                            "symbol": "T.oz",
                            "name": "Troy Ounce"
                          }
                        },
                        {
                          "symbol": "NG-FUT",
                          "name": "Natural Gas Futures",
                          "category": "Energy",
                          "status": "active",
                          "updateInterval": "PER_MINUTE",
                          "currency": {
                            "code": "USD",
                            "name": "US Dollar",
                            "symbol": "$"
                          },
                          "unit": {
                            "symbol": "MMBtu",
                            "name": "Million British Thermal Units"
                          }
                        },
                        {
                          "symbol": "NG-EU",
                          "name": "Natural Gas, Europe",
                          "category": "Energy",
                          "status": "active",
                          "updateInterval": "PER_MONTH",
                          "exchange": "World Bank",
                          "currency": {
                            "code": "USD",
                            "name": "US Dollar",
                            "symbol": "$"
                          },
                          "unit": {
                            "symbol": "MMBtu",
                            "name": "Million British Thermal Units"
                          }
                        },
                        {
                          "symbol": "UANEU",
                          "name": "Urea Ammonium Nitrate",
                          "category": "Industrial",
                          "status": "inactive",
                          "updateInterval": "PER_MINUTE",
                          "deprecationDate": "2024-04-14",
                          "currency": {
                            "code": "USD",
                            "name": "US Dollar",
                            "symbol": "$"
                          },
                          "unit": {
                            "symbol": "T",
                            "name": "Metric Ton"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            },
            "headers": {
              "X-AF-Credits-Cost": {
                "$ref": "#/components/headers/X-AF-Credits-Cost"
              }
            }
          },
          "400": {
            "description": "Bad Request — Missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missingApiKey": {
                    "summary": "API key not sent",
                    "value": {
                      "error": "Invalid Param Exception",
                      "message": "Please provide apiKey",
                      "path": "/v2.0/commodity/symbols",
                      "status": 400,
                      "timestamp": "2026-11-25T10:07:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — API key invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalidApiKey": {
                    "summary": "Invalid API key",
                    "value": {
                      "error": "API Access Exception",
                      "message": "Provided API key is invalid. [For Technical Support: support@apifreaks.com]",
                      "path": "/v2.0/commodity/symbols",
                      "status": 401,
                      "timestamp": "2026-11-25T10:07:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found — Wrong HTTP method used on the endpoint (e.g. POST instead of GET)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "wrongMethod": {
                    "summary": "Wrong HTTP method used on the endpoint",
                    "value": {
                      "error": "Resource Not Found",
                      "message": "The requested resource could not be found. Please verify the URL and try again.",
                      "path": "/v2.0/commodity/symbols",
                      "status": 404,
                      "timestamp": "2026-11-25T10:07:00.000Z"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuthHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-apiKey",
        "description": "Pass your API key via the X-apiKey request header."
      },
      "ApiKeyAuthQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "apiKey",
        "description": "Pass your API key via the apiKey query parameter."
      }
    },
    "schemas": {
      "CommoditySymbolsResponse": {
        "type": "object",
        "required": ["success", "symbols"],
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Indicates whether the API request was successful."
          },
          "symbols": {
            "type": "array",
            "description": "Array of commodity symbol objects with metadata.",
            "items": {
              "$ref": "#/components/schemas/CommoditySymbolItem"
            }
          }
        },
        "description": "Commodity symbols response containing an array of supported commodity symbol objects."
      },
      "CommoditySymbolItem": {
        "type": "object",
        "description": "A single commodity symbol with metadata.",
        "required": [
          "symbol",
          "name",
          "category",
          "status",
          "updateInterval",
          "currency",
          "unit"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "description": "Unique identifier/ticker symbol for the commodity (e.g., XAU, NG-FUT). Use this value in the `symbols` parameter of the rate endpoints."
          },
          "name": {
            "type": "string",
            "description": "Full name of the commodity (e.g., Gold, Natural Gas Futures)."
          },
          "description": {
            "type": "string",
            "description": "Short description of the commodity. May be an empty string for some symbols."
          },
          "category": {
            "type": "string",
            "description": "Category the commodity belongs to (e.g., Metals, Energy, Agriculture, Industrial, Raw Materials, Oils and Meals, Textiles, Meats, Poultry, Livestock)."
          },
          "status": {
            "type": "string",
            "enum": ["active", "inactive"],
            "description": "Current status of the commodity. `inactive` means the symbol is deprecated: latest rates are unavailable, but historical rates remain available up to its `deprecationDate`."
          },
          "updateInterval": {
            "type": "string",
            "enum": [
              "PER_SECOND",
              "PER_MINUTE",
              "PER_10_MINUTES",
              "PER_HOUR",
              "PER_DAY",
              "PER_WEEK",
              "PER_MONTH"
            ],
            "description": "Rate at which the price is updated."
          },
          "exchange": {
            "type": "string",
            "description": "Optional. Data source for the symbol (e.g., World Bank). Present only for some symbols."
          },
          "deprecationDate": {
            "type": "string",
            "format": "date",
            "description": "Optional. Present only when `status` is `inactive`. Date the symbol was deprecated (YYYY-MM-DD)."
          },
          "currency": {
            "$ref": "#/components/schemas/CommodityCurrency"
          },
          "unit": {
            "$ref": "#/components/schemas/CommodityUnit"
          }
        }
      },
      "CommodityCurrency": {
        "type": "object",
        "description": "Currency information for a commodity.",
        "required": ["code", "name", "symbol"],
        "properties": {
          "code": {
            "type": "string",
            "description": "ISO 4217 currency code."
          },
          "name": {
            "type": "string",
            "description": "Full name of the currency."
          },
          "symbol": {
            "type": "string",
            "description": "Symbol of the currency (e.g., $)."
          }
        }
      },
      "CommodityUnit": {
        "type": "object",
        "description": "Unit of measurement for a commodity.",
        "required": ["symbol", "name"],
        "properties": {
          "symbol": {
            "type": "string",
            "description": "Abbreviated unit symbol (e.g., T.oz, MMBtu)."
          },
          "name": {
            "type": "string",
            "description": "Full name of the unit of measurement (e.g., Troy Ounce)."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standard error envelope returned by the API on failed requests.",
        "required": ["message"],
        "properties": {
          "error": {
            "type": "string",
            "description": "Short error category or exception type."
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message describing the failure."
          },
          "path": {
            "type": "string",
            "description": "API endpoint path that produced the error."
          },
          "status": {
            "type": "integer",
            "description": "HTTP status code returned with the error."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the error occurred (ISO 8601)."
          }
        }
      }
    },
    "headers": {
      "X-AF-Credits-Cost": {
        "description": "Specifies the number of credits consumed by the current request.",
        "schema": {
          "type": "integer"
        }
      }
    }
  },
  "security": [
    {
      "ApiKeyAuthHeader": []
    },
    {
      "ApiKeyAuthQuery": []
    }
  ]
}
