  "components": {
    "securitySchemes": {
      "ApiKeyAuthHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-apiKey",
        "description": "Pass your API key via the X-apiKey request header."
      },
      "ApiKeyAuthQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "apiKey",
        "description": "Pass your API key via the apiKey query parameter."
      }
    },
    "schemas": {
      "CommodityIntradayResponse": {
        "type": "object",
        "description": "Intraday response containing the prices of the requested symbol keyed by UTC timestamp.",
        "required": [
          "success",
          "symbol",
          "date",
          "interval",
          "startTime",
          "count",
          "nextStartTime",
          "rates"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "description": "`true` for successful requests."
          },
          "symbol": {
            "type": "string",
            "description": "The symbol the prices belong to."
          },
          "date": {
            "type": "string",
            "description": "The UTC day requested. Format: `YYYY-MM-DD`.",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "interval": {
            "type": "string",
            "description": "The interval used, in lowercase form (`5M` comes back as `5m`).",
            "enum": [
              "1m",
              "5m",
              "10m",
              "15m",
              "30m",
              "45m",
              "1h",
              "2h",
              "4h",
              "8h",
              "12h",
              "1d"
            ]
          },
          "startTime": {
            "type": "string",
            "description": "First mark of the window, `HH:mm` UTC.",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "count": {
            "type": "integer",
            "description": "Number of points in `rates` (at most 100).",
            "maximum": 100,
            "minimum": 0
          },
          "nextStartTime": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              {
                "type": "null"
              }
            ],
            "description": "`HH:mm` value to pass as `startTime` for the next page, or `null` when the window reached the end of the day (or the current minute, for today)."
          },
          "rates": {
            "type": "object",
            "description": "Prices keyed by ISO 8601 UTC timestamp (for example `2026-10-14T18:00:00Z`), in ascending order. Values are rounded to two decimals. A mark with no recorded price is left out rather than filled in.",
            "additionalProperties": {
              "type": "number",
              "format": "float"
            }
          },
          "metadata": {
            "type": "object",
            "description": "Unit and currency of the prices, keyed by the requested symbol. Omitted when the request sets `metadata=false`.",
            "additionalProperties": {
              "$ref": "#/components/schemas/CommodityIntradayMetadata"
            }
          },
          "unresolved": {
            "type": "object",
            "description": "Present when the symbol you sent was matched to a single alternative (200, with `resolvedTo`, for example `GOLD` answered as `XAU`), or not recognized at all (404, with a `suggestions` array when close matches exist).",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "description": "Detail message explaining how this symbol was handled."
                },
                "resolvedTo": {
                  "type": "string",
                  "description": "The supported symbol the request was answered with."
                },
                "suggestions": {
                  "type": "array",
                  "description": "Optional list of supported symbols that closely match the unresolved symbol.",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "CommodityIntradayMetadata": {
        "type": "object",
        "description": "Unit and currency of the prices for one commodity.",
        "properties": {
          "unit": {
            "type": "string",
            "description": "Unit the commodity is priced in (for example `T.oz` or `Bbl`)."
          },
          "quote": {
            "type": "string",
            "description": "Currency the prices are quoted in (for example `USD`)."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standard error envelope returned by the API on failed requests. Gateway-level validation errors populate status; commodity-service errors (date/symbol/data validation) populate code instead: check whichever is present.",
        "required": [
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Short error category or exception type (e.g., Invalid Param Exception, VALIDATION_ERROR, SYMBOL_NOT_FOUND, DATA_NOT_FOUND)."
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message describing the failure."
          },
          "path": {
            "type": "string",
            "description": "API endpoint path (gateway errors) or internal service path (commodity-service errors) that produced the error."
          },
          "status": {
            "type": "integer",
