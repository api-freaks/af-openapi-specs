{
  "openapi": "3.1.1",
  "info": {
    "title": "Commodity Intraday Rates API",
    "version": "2.0.0",
    "description": "Timestamped prices for one commodity on any UTC day, at an interval from one minute to one day. Each point is the single price recorded at that exact time, keyed by its ISO 8601 UTC timestamp. A response holds up to 100 points; when the day has more, `nextStartTime` is the value to send as `startTime` for the next page. Available only for commodities updated every second, every minute, or every 10 minutes.",
    "contact": {
      "name": "APIFreaks Support",
      "url": "https://apifreaks.com/contact",
      "email": "support@apifreaks.com"
    }
  },
  "servers": [
    {
      "url": "https://api.apifreaks.com/v2.0",
      "description": "Commodity Intraday Rates API Server"
    }
  ],
  "paths": {
    "/commodity/rates/intraday": {
      "get": {
        "tags": [
          "Commodity APIs"
        ],
        "summary": "Get intraday commodity rates",
        "description": "Returns the prices of one commodity through a UTC day at the requested interval, keyed by UTC timestamp. Each request costs a flat 50 credits however many points it returns.",
        "operationId": "getCommodityIntradayRates",
        "parameters": [
          {
            "name": "symbols",
            "in": "query",
            "required": true,
            "description": "Exactly one commodity symbol. Case-insensitive. Sending two or more returns a 400. Only symbols updated every second, every minute, or every 10 minutes have intraday rates; symbols updated hourly or less often return a 400. Use the Commodity Symbols endpoint for all valid values.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "interval",
            "in": "query",
            "required": true,
            "description": "Spacing between points. Case-insensitive. Symbols updated every 10 minutes accept only `10m`, `30m`, `1h`, `2h`, `4h`, `8h`, `12h`, `1d`.",
            "schema": {
              "type": "string",
              "enum": [
                "1m",
                "5m",
                "10m",
                "15m",
                "30m",
                "45m",
                "1h",
                "2h",
                "4h",
                "8h",
                "12h",
                "1d"
              ]
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "The UTC day to read, in `YYYY-MM-DD` format. Cannot be in the future. For today, points stop at the current UTC minute.",
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          {
            "name": "startTime",
            "in": "query",
            "required": false,
            "description": "First mark of the window, as a 24-hour UTC time in `HH:mm`. Must fall on a mark of the interval (for example, `14:30` works for `5m` or `30m`, but not for `1h`). For `1d` it can only be `00:00`.",
            "schema": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "default": "00:00"
            }
          },
          {
            "name": "metadata",
            "in": "query",
            "required": false,
            "description": "Whether to include the `metadata` object. Pass `false` to receive only the prices.",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommodityIntradayResponse"
