                  "value": {
                    "urls": [
                      {
                        "url": "https://example.com",
                        "file_type": "PNG"
                      },
                      {
                        "url": "https://github.com",
                        "file_type": "JPEG",
                        "full_page": true
                      }
                    ]
                  }
                }
              }
            }
          }
        },
