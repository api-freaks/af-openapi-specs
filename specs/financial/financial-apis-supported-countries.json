{
  "openapi": "3.1.1",
  "info": {
    "title": "Financial APIs Supported Countries Reference",
    "version": "1.0.0",
    "description": "Retrieve the countries and states supported by the VAT, IBAN, and SWIFT APIs. Use the `type` query parameter (`vat`, `iban` or `swift`) to choose which list is returned; a call with a valid `type` returns only that list, under its own top-level key (VAT_Supported_Countries_And_States, IBAN_Supported_Countries or SWIFT_Supported_Countries). When `type` is omitted or is not one of the three values, all three lists are returned. VAT entries are keyed by lowercase country name and include an ISO code plus, for a handful of countries (US, Canada, Spain), a nested map of sub-national state/region codes. IBAN and SWIFT entries are flat arrays of {name, countryCode} objects.",
    "contact": {
      "name": "APIFreaks Support",
      "url": "https://apifreaks.com/contact",
      "email": "support@apifreaks.com"
    }
  },
  "servers": [
    {
      "url": "https://api.apifreaks.com/v1.0",
      "description": "Financial APIs Supported Countries API Server"
    }
  ],
  "paths": {
    "/vat/supported-countries": {
      "get": {
        "tags": ["Financial APIs"],
        "summary": "Get supported countries",
        "description": "Returns the list of countries (and, for VAT, states) supported by the VAT, IBAN, or SWIFT API, depending on the `type` parameter. Only the requested list is returned.",
        "operationId": "getSupportedCountries",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["json", "xml"],
              "default": "json"
            },
            "description": "Format of the response. Default is JSON."
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "vat",
                "iban",
                "swift"
              ]
            },
            "description": "Selects which list to return: `vat`, `iban` or `swift`. Each value returns only its own list. Matching is case-insensitive. If omitted, or set to any other value, all three lists are returned. There is no default."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response — returns the list selected by `type`, or all three lists when `type` is omitted or not recognised",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SupportedCountriesResponse"
                },
                "examples": {
                  "allLists": {
                    "summary": "type omitted — all three lists (truncated)",
                    "value": {
                      "VAT_Supported_Countries_And_States": [
                        {
                          "germany": {
                            "code": "de"
                          }
                        }
                      ],
                      "IBAN_Supported_Countries": [
                        {
                          "name": "Albania",
                          "countryCode": "AL"
                        }
                      ],
                      "SWIFT_Supported_Countries": [
                        {
                          "name": "Afghanistan",
                          "countryCode": "AF"
                        }
                      ]
                    }
                  },
                  "vatList": {
                    "summary": "type=vat — VAT list only (truncated)",
                    "value": {
                      "VAT_Supported_Countries_And_States": [
                        {
                          "germany": {
                            "code": "de"
                          }
                        },
                        {
                          "united_states": {
                            "code": "us",
                            "states": {
                              "california": "us:ca",
                              "new_york": "us:ny",
                              "texas": "us:tx"
                            }
                          }
                        }
                      ]
                    }
                  },
                  "ibanList": {
                    "summary": "type=iban — IBAN list only (truncated)",
                    "value": {
                      "IBAN_Supported_Countries": [
                        {
                          "name": "Albania",
                          "countryCode": "AL"
                        },
                        {
                          "name": "Germany",
                          "countryCode": "DE"
                        }
                      ]
                    }
                  },
                  "swiftList": {
                    "summary": "type=swift — SWIFT list only (truncated)",
                    "value": {
                      "SWIFT_Supported_Countries": [
                        {
                          "name": "Afghanistan",
                          "countryCode": "AF"
                        },
                        {
                          "name": "Germany",
                          "countryCode": "DE"
                        }
                      ]
                    }
                  }
                }
              }
            },
            "headers": {
              "X-AF-Credits-Cost": {
                "$ref": "#/components/headers/X-AF-Credits-Cost"
              }
            }
          },
          "406": {
            "description": "Unsupported Media Type — format is not json or xml",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "badFormat": {
                    "summary": "format value not supported",
                    "value": {
                      "error": "Unsupported Media Type",
                      "message": "The media type specified in the request is not supported. For more details, please refer to the API documentation.",
                      "path": "/v1.0/vat/supported-countries",
                      "status": 406,
                      "timestamp": "2026-11-25T10:00:55.394Z"
                    }
                  }
                }
              }
            },
            "headers": {
              "X-AF-Credits-Cost": {
                "$ref": "#/components/headers/X-AF-Credits-Cost"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuthHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-apiKey",
        "description": "Pass your API key via the X-apiKey request header."
      },
      "ApiKeyAuthQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "apiKey",
        "description": "Pass your API key via the apiKey query parameter."
      }
    },
    "schemas": {
      "SupportedCountriesResponse": {
        "type": "object",
        "description": "Countries and states supported by the VAT, IBAN, and SWIFT APIs. Exactly one of the three properties is present, depending on the `type` request parameter.",
        "properties": {
          "VAT_Supported_Countries_And_States": {
            "type": "array",
            "description": "Array of single-key objects, one per supported VAT country. Each key is the lowercase, underscore-separated country name.",
            "items": {
              "type": "object",
              "description": "A single VAT-supported country, keyed by its lowercase name.",
              "additionalProperties": {
                "title": "VatCountryEntry",
                "$ref": "#/components/schemas/VatCountryEntry"
              }
            }
          },
          "IBAN_Supported_Countries": {
            "type": "array",
            "description": "Array of countries supported by the IBAN Validation API.",
            "items": {
              "$ref": "#/components/schemas/IbanCountryEntry"
            }
          },
          "SWIFT_Supported_Countries": {
            "type": "array",
            "description": "Array of countries supported by the SWIFT/BIC Code Lookup and Finder APIs.",
            "items": {
              "$ref": "#/components/schemas/SwiftCountryEntry"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Short error category or exception type."
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message describing the failure."
          },
          "path": {
            "type": "string",
            "description": "API endpoint path that produced the error."
          },
          "status": {
            "type": "integer",
            "description": "HTTP status code returned with the error."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the error occurred (ISO 8601)."
          }
        },
        "description": "Standard error envelope returned by the API on failed requests."
      },
      "VatCountryEntry": {
        "type": "object",
        "description": "VAT country metadata: an ISO 3166-1 alpha-2 code, plus an optional map of sub-national states/regions for countries with state-level VAT (US, Canada, Spain).",
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code, lowercase."
          },
          "states": {
            "type": "object",
            "description": "Map of state/region name to its combined country:state code. Only present for countries with sub-national VAT rates.",
            "additionalProperties": {
              "title": "StateCode",
              "type": "string",
              "description": "Combined country:state identifier (e.g. us:ca)."
            }
          }
        }
      },
      "IbanCountryEntry": {
        "type": "object",
        "description": "A single country supported by the IBAN Validation API.",
        "required": ["countryCode", "name"],
        "properties": {
          "countryCode": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code."
          },
          "name": {
            "type": "string",
            "description": "Full country name."
          }
        }
      },
      "SwiftCountryEntry": {
        "type": "object",
        "description": "A single country supported by the SWIFT/BIC Code Lookup and Finder APIs.",
        "required": ["name", "countryCode"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Full country name."
          },
          "countryCode": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code."
          }
        }
      }
    },
    "headers": {
      "X-AF-Credits-Cost": {
        "description": "Specifies the number of credits consumed by the current request.",
        "schema": {
          "type": "integer"
        }
      }
    }
  },
  "security": [
    {
      "ApiKeyAuthHeader": []
    },
    {
      "ApiKeyAuthQuery": []
    }
  ]
}
