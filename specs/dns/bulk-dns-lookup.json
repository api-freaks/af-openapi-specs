{
  "openapi": "3.1.1",
  "info": {
    "title": "Bulk DNS Lookup API - DNS Records for Up to 100 Hostnames in One Request",
    "version": "1.0.0",
    "description": "Perform DNS lookups for up to 100 hostnames in a single POST request and retrieve A, AAAA, MX, NS, SOA, SPF, TXT, and CNAME records for each domain. The response is a bulk_dns_info array where each entry contains a status flag, query timestamp, domain name, registration status, and the full set of matching DNS records, plus a dnsTypes map listing which record types were found. IP addresses can be included alongside domain names to retrieve PTR records for reverse DNS lookups. Use the format parameter to choose between JSON and XML output.",
    "contact": {
      "name": "APIFreaks Support",
      "url": "https://apifreaks.com/contact",
      "email": "support@apifreaks.com"
    }
  },
  "servers": [
    {
      "url": "https://api.apifreaks.com/v1.0",
      "description": "Bulk DNS Lookup API Server"
    }
  ],
  "paths": {
    "/domain/dns/live": {
      "post": {
        "tags": ["DNS APIs"],
        "summary": "Retrieve A, AAAA, MX, NS, SOA, SPF, TXT, and CNAME DNS records of multiple hostnames in a single request",
        "description": "Perform DNS lookups for multiple hostnames in a single request. Supports up to 100 hostnames per request and returns DNS records including A, AAAA, MX, NS, SOA, SPF, TXT, and CNAME records. IP addresses in `ipAddresses` are looked up for PTR records when `type` is `PTR` or `all`. Entries in the response are not guaranteed to follow request order, and a hostname submitted more than once is returned once. Each hostname in `domainNames` costs 15 credits, including duplicates and unregistered domains; hostnames that cannot be processed, IP addresses, and error responses are not charged.",
        "operationId": "bulkDnsLookup",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Format of the response. With `xml` the response is served as `application/xml` with the root element `BulkDnsInfo`, containing a `bulkDnsResponse` element with one `dnsInfo` element per entry and one `dnsRecord` element per record.",
            "schema": {
              "type": "string",
              "enum": ["json", "xml"],
              "default": "json"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": false,
            "description": "A comma-separated list of DNS record types for lookup (for example `MX,TXT`), or `all` for every supported type. Values are case-insensitive. `PTR` (also included in `all`) is looked up only for the IP addresses in `ipAddresses`; with any other type the IP addresses are returned with an empty `dnsRecords` array.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["A", "AAAA", "MX", "NS", "SOA", "SPF", "TXT", "CNAME", "PTR", "all"]
              }
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkDNSLookupRequest"
              },
              "examples": {
                "typicalRequest": {
                  "summary": "Bulk lookup for two domains and one IP",
                  "value": {
                    "domainNames": ["google.com", "example.com"],
                    "ipAddresses": ["8.8.8.8"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful DNS lookup response. Each entry in the bulk_dns_info array corresponds to one queried domain or IP address. Entries are not guaranteed to follow request order. A registered domain with no matching records, and an unregistered domain (domainRegistered false), are returned with an empty dnsRecords array.",
